# Copy values into your deployment's environment. Nothing loads this file automatically.
SIFTKEEP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SIFTKEEP_MODE=observe
# Optional; use an HTTPS receiver you control to forward alerts to your preferred channel.
# SIFTKEEP_WEBHOOK_URL=https://your-service.example/siftkeep-alerts
# SIFTKEEP_WEBHOOK_SECRET=use-a-different-random-secret-of-at-least-32-characters
# GitHub search CLI only. Never expose this token to the browser.
# GITHUB_TOKEN=your-github-token
